---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContentCard from '../../components/ContentCard.astro';
import { SITE_TITLE } from '../../consts';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const years = [...new Set(posts.map(post => post.data.pubDate.getUTCFullYear()))];
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const tagCount = (tag: string) => posts.filter(post => post.data.tags.includes(tag)).length;
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`博客 · ${SITE_TITLE}`} description="关于 AI、软件工程与日常工具的思考和实践。" /></head>
  <body>
    <Header />
    <main id="main" class="container">
      <header class="page-heading"><h1>博客</h1><p class="page-intro">关于 AI、软件，以及把想法变成现实的过程。</p></header>
      {tags.length > 0 && <div class="blog-filters" hidden>
        <span class="filter-label" id="filter-label">标签</span>
        <div class="tag-filter-bar" role="group" aria-labelledby="filter-label">
          <button type="button" class="tag-filter" data-filter-tag="" aria-pressed="true">全部 <span>{posts.length}</span></button>
          {tags.map(tag => <button type="button" class="tag-filter" data-filter-tag={tag} aria-pressed="false">{tag} <span>{tagCount(tag)}</span></button>)}
        </div>
        <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
      </div>}
      <p class="empty-state" id="no-tag-matches" hidden>没有符合这个标签的文章。<a href="/blog/" data-clear-filter>查看全部文章</a></p>
      {years.map(year => <section class="archive-year" aria-labelledby={`year-${year}`}><h2 id={`year-${year}`}>{year}</h2><div class="blog-grid archive-grid">{posts.filter(post => post.data.pubDate.getUTCFullYear() === year).map(post => <ContentCard post={post} />)}</div></section>)}
      {!posts.length && <p class="empty-state">还没有文章，下一篇想法正在路上。</p>}
    </main>
    <Footer />
    <script>
      const main = document.querySelector<HTMLElement>('#main');
      const filters = main?.querySelector<HTMLElement>('.blog-filters');
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
      const cards = [...document.querySelectorAll<HTMLElement>('[data-post-tags]')];
      const groups = [...document.querySelectorAll<HTMLElement>('.archive-year')];
      const status = document.querySelector<HTMLElement>('#filter-status');
      const empty = document.querySelector<HTMLElement>('#no-tag-matches');
      const tagOfURL = () => new URL(window.location.href).searchParams.get('tag') || '';
      const apply = (tag: string) => {
        let count = 0;
        cards.forEach(card => {
          const tags: string[] = JSON.parse(card.dataset.postTags || '[]');
          card.hidden = Boolean(tag) && !tags.includes(tag);
          if (!card.hidden) count++;
        });
        groups.forEach(group => { group.hidden = !group.querySelector('[data-post-tags]:not([hidden])'); });
        buttons.forEach(button => { button.setAttribute('aria-pressed', String(button.dataset.filterTag === tag)); });
        if (status) status.textContent = tag ? `标签「${tag}」· ${count} 篇文章` : `共 ${count} 篇文章`;
        if (empty) empty.hidden = count !== 0 || !tag;
      };
      const choose = (tag: string) => {
        const url = new URL(window.location.href);
        if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
        if (url.href !== window.location.href) window.history.pushState(null, '', url);
        apply(tag);
      };
      if (main) {
        if (filters) filters.hidden = false;
        buttons.forEach(button => button.addEventListener('click', () => choose(button.dataset.filterTag || '')));
        main.addEventListener('click', event => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest<HTMLAnchorElement>('a[data-tag-link], a[data-clear-filter]');
          if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault();
          choose(link.hasAttribute('data-clear-filter') ? '' : new URL(link.href).searchParams.get('tag') || '');
        });
        window.addEventListener('popstate', () => apply(tagOfURL()));
        apply(tagOfURL());
      }
    </script>
  </body>
</html>
