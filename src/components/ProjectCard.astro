---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project } = Astro.props;
const primary = project.website ?? project.repository;
---
<article class="content-card project-card">
  <a class="cover-link" href={primary} tabindex="-1" aria-hidden="true">
    <img src={project.cover} alt="" width="1600" height="900" loading="lazy" decoding="async" />
  </a>
  <div class="card-copy">
    <h3 class="project-title">
      {project.icon && <img class="project-icon" src={project.icon} alt="" width="24" height="24" loading="lazy" />}
      <a href={primary}>{project.name}</a>
    </h3>
    <p class="card-description">{project.description}</p>
    <p class="card-meta">{project.category}</p>
    <div class="project-links">
      {project.website && <a href={project.website} aria-label={`访问 ${project.name} 项目页`}>项目页 <span aria-hidden="true">↗</span></a>}
      <a href={project.repository} aria-label={`${project.name} 的 GitHub 仓库`}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
