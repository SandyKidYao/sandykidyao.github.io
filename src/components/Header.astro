---
const { pathname } = Astro.url;
---
<a class="skip-link" href="#main">跳到主要内容</a>
<header class="site-header">
  <div class="container header-row">
    <a class="wordmark" href="/" aria-label="SandyKid 首页"><span class="wordmark-glyph" aria-hidden="true">ᕕ( ᐛ )ᕗ</span><span>SandyKid<span class="wordmark-dot">.</span></span></a>
    <div class="header-actions">
      <nav aria-label="主导航">
        <a href="/blog/" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>博客</a>
        <a href="/projects/" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>项目</a>
        <a class="github-nav" href="https://github.com/SandyKidYao">GitHub</a>
      </nav>
      <button class="theme-button" id="theme-toggle" type="button" aria-label="切换颜色主题" title="切换颜色主题">
        <svg class="theme-icon theme-system" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <svg class="theme-icon theme-light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
        <svg class="theme-icon theme-dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z"/></svg>
      </button>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const labels: Record<string, string> = { system: '跟随系统', light: '亮色', dark: '暗色' };
  const order = () => ['system', media.matches ? 'light' : 'dark', media.matches ? 'dark' : 'light'];
  const update = () => {
    if (!button) return;
    const preference = document.documentElement.dataset.themePreference || 'system';
    const choices = order();
    const next = choices[(choices.indexOf(preference) + 1) % choices.length];
    const label = `当前${labels[preference]}，切换到${labels[next]}`;
    button.setAttribute('aria-label', label);
    button.title = label;
  };
  button?.addEventListener('click', () => {
    const choices = order();
    const current = document.documentElement.dataset.themePreference || 'system';
    const next = choices[(choices.indexOf(current) + 1) % choices.length];
    document.documentElement.dataset.themePreference = next;
    document.documentElement.dataset.theme = next === 'system' ? (media.matches ? 'dark' : 'light') : next;
    try { localStorage.setItem('sk-theme', next); } catch { /* Storage is optional. */ }
    update();
  });
  window.addEventListener('themechange', update);
  update();
</script>
